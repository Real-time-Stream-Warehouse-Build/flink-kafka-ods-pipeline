<?xml version="1.0" encoding="UTF-8"?>
<!--
  Flink Local Run 日志配置
  打包后随 fat jar 一起, 避免 shade 排除后丢失
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- Flink 主日志 -->
        <Logger name="org.apache.flink" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <!-- Kafka 客户端日志 (调试时可开 DEBUG) -->
        <Logger name="org.apache.kafka" level="WARN"/>
        <!-- MySQL 驱动 -->
        <Logger name="com.mysql" level="WARN"/>
        <!-- 业务代码 -->
        <Logger name="com.ods" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
